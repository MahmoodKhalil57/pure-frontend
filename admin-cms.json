{
  "$schema": "./admin-cms.schema.json",
  "version": 2,
  "project": {
    "name": "Qalam & Ahar",
    "slug": "qalam-ahar"
  },
  "forms": [
    {
      "slug": "opening-notice",
      "name": "Opening notice",
      "status": "published",
      "successMessage": "You are on the list — watch your inbox.",
      "fields": [
        {
          "name": "email",
          "label": "Email address",
          "type": "email",
          "required": true,
          "placeholder": "you@example.com"
        },
        {
          "name": "name",
          "label": "Your name",
          "type": "text",
          "width": "half"
        },
        {
          "name": "phone",
          "label": "Phone",
          "type": "tel",
          "width": "half"
        }
      ],
      "site": {
        "submitLabel": "Put my name down",
        "spamProtection": "honeypot",
        "retentionDays": 0
      }
    },
    {
      "slug": "wholesale",
      "name": "Wholesale enquiry (trade)",
      "status": "published",
      "successMessage": "Thanks — we will come back to you with sizes and lead times.",
      "fields": [
        {
          "name": "email",
          "label": "Email",
          "type": "email",
          "required": true
        },
        {
          "name": "volume",
          "label": "Expected volume",
          "type": "select",
          "options": [
            {
              "value": "small",
              "label": "Under 50"
            },
            {
              "value": "large",
              "label": "50 or more"
            },
            {
              "value": "pallet",
              "label": "A pallet or more"
            }
          ]
        },
        {
          "name": "detail",
          "label": "Tell us more",
          "type": "textarea",
          "showWhen": {
            "field": "volume",
            "is": "equal",
            "value": "large"
          }
        }
      ],
      "site": {
        "submitLabel": "Send enquiry",
        "spamProtection": "honeypot",
        "retentionDays": 0
      }
    }
  ]
}
